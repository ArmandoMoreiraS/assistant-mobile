# OpenAI API key — required for OpenAI models (GPT-4, embeddings, etc.)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Google Gemini API key — required for Gemini models (free tier available)
# Get yours at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Anthropic API key — required for Claude model access
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# LangSmith API key — required for LangChain tracing and observability
# Get yours at: https://smith.langchain.com/
LANGCHAIN_API_KEY=your-langsmith-api-key-here

# Enable LangSmith tracing (true/false) — set to true to trace LLM calls
LANGCHAIN_TRACING_V2=false
